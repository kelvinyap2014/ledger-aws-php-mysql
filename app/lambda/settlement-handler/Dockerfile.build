# Multi-stage Dockerfile for NestJS Lambda Settlement Handler
# Stage 1: Build with all dependencies
FROM node:22-alpine AS builder

WORKDIR /build

# Copy source files
COPY package*.json tsconfig.json ./
COPY src ./src

# Install all dependencies and build
RUN npm ci && npm run build

# Stage 2: Runtime - copy only what Lambda needs
FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY --from=builder /build/package*.json ./

# Install ONLY production dependencies
RUN npm ci --omit=dev && npm cache clean --force

# Copy compiled handler
COPY --from=builder /build/dist ./dist

# Create deployment zip with minimal files
RUN apk add --no-cache zip && \
    zip -r function.zip dist/ node_modules/ package.json

# Default command shows the artifact is ready
CMD tail -f /dev/null
